# Copy to .env.local and adjust.

# 'mock'  — generate 50,000 records in the browser (default, no backend needed)
# 'http'  — call a real backend through src/api/httpApi.ts
VITE_API_MODE=mock

# Only used when VITE_API_MODE=http
VITE_API_BASE_URL=https://your-los-api.example.com/api

# Only needed for GitHub Pages project sites, where the app is served from
# https://<user>.github.io/<repo>/ rather than the domain root.
# VITE_BASE=/los-onepager/
